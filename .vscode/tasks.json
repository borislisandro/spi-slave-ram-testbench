{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SPI: Compile",
            "type": "shell",
            "command": "make compile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SPI: Simulate",
            "type": "shell",
            "command": "make simulate",
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SPI: Open waves",
            "type": "shell",
            "command": "make waves",
            "problemMatcher": []
        },
        {
            "label": "SPI: Lint",
            "type": "shell",
            "command": "make lint",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SPI: Coverage",
            "type": "shell",
            "command": "make coverage-open",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SPI: Coverage GUI",
            "type": "shell",
            "command": "make coverage-gui",
            "problemMatcher": []
        },
        {
            "label": "SPI: Check all",
            "type": "shell",
            "command": "make check",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SPI: Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ]
}
