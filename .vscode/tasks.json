            "type": "shell",
            "command": "make",
            "args": [
                "coverage-open"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "coverage-open"
                ]
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "SPI: Check all",
            "type": "shell",
            "command": "make",
            "args": [
                "check"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "check"
                ]
            },
            "problemMatcher": [
