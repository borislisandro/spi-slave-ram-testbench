{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SPI: Compile",
            "type": "shell",
            "command": "make",
            "args": [
                "compile"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "compile"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "SPI: Simulate",
            "type": "shell",
            "command": "make",
            "args": [
                "simulate"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "simulate"
                ]
            },
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "SPI: Compile and simulate",
            "dependsOn": [
                "SPI: Compile",
                "SPI: Simulate"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "SPI: Open waves",
            "type": "shell",
            "command": "make",
            "args": [
                "waves"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "waves"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "SPI: Kill GTKWave",
            "type": "shell",
            "command": "make",
            "args": [
                "kill-waves"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "kill-waves"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "SPI: Lint",
            "type": "shell",
            "command": "make",
            "args": [
                "lint"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\wsl.ps1",
                    "lint"
                ]
            },
            "problemMatcher": [
